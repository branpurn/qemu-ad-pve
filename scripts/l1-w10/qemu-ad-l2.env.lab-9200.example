# Lab-only overrides for VM 9200's L1 (the original hand-built lab, not setup.sh installs).
# Copy to /etc/qemu-ad-l2.env inside L1 ONLY if you want the old extra identity checks back;
# start-l2.sh and resolve-windows-disk.sh read it. Without it the lab disk still resolves
# uniquely by serial drive-scsi1 + LABEL=Windows + NTFS/size (score 150 instead of 200).
#
# NTFS volume UUID of the lab Windows disk (copied from VM 9101, docs/gpu-phase-windows-l2.md).
# Lab-specific: never set this on a greenfield install (setup.sh relies on the serial).
WIN_DISK_UUID=762491EA2491AE1D
# Lab disk is 80 GiB (vm-9200-disk-2.qcow2).
WIN_DISK_MIN_GB=70
WIN_DISK_MAX_GB=90
# Lab L1 still runs the legacy kvm-patched/1.0 build (6.12.111-kvmpatch1); see docs/SETUP.md.
KVM_PATCH_RE='l1-dkms|kvmpatch'
