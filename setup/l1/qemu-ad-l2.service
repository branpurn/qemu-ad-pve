# Windows L2 with the passed-through GPU, started at L1 boot and shut down cleanly (ACPI)
# before L1 powers off. Installed by setup.sh (setup/l1/qad-l1.sh scripts).
[Unit]
Description=qemu-ad-pve Windows L2 (GPU passthrough)
Wants=network-online.target
After=network-online.target systemd-modules-load.service
ConditionPathExists=/root/w10/VARS.fd

[Service]
Type=forking
PIDFile=/root/w10/w10.pid
ExecStart=/root/w10/start-l2.sh
ExecStop=/root/w10/stop-l2.sh
ExecStopPost=/root/w10/l2net-down.sh
TimeoutStartSec=180
TimeoutStopSec=300
Restart=no

[Install]
WantedBy=multi-user.target
